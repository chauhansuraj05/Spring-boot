<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd">


	<bean id = "student" class = "com.ty.Student">
	<property name="id" value = "101"></property>
	<property name="name" value = "Smith"></property>
	<property name="age" value = "24"></property>
	
	</bean>
	
	<bean id = "teacher" class = "com.ty.Teacher">
	<property name="id" value = "102"></property>
	<property name="name" value = "Silvia"></property>
	<property name="age" value = "23"></property>
	
	</bean>
	
	<bean id = "subject" class = "com.ty.Subject">
	<property name="id" value = "103"></property>
	<property name="sub_name" value = "Java"></property>
	<property name="credits" value = "4.5"></property>
	
	</bean>
    

</beans>